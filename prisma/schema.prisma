generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id                                 String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug                               String                @unique
  nome                               String
corPrimaria   String? @default("#7c3aed")
corSecundaria String? @default("#a855f7")
corSidebar    String? @default("#0f172a")
  descricao                          String?
  telefone                           String?
  endereco                           String?
  logoUrl                            String?
  midiaUrl                           String?
  tipoMidia                          String?               @default("imagem")
  ativo                              Boolean               @default(true)
  createdAt                          DateTime              @default(now()) @db.Timestamp(6)
  updatedAt                          DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  whatsapp                           String?
  instagram                          String?
  whatsappInstance                   String?
  whatsappAtivo                      Boolean               @default(false)
  plano                              String?               @default("basico")
  trialAtivo                         Boolean               @default(true)
  trialExpiraEm                      DateTime?             @db.Timestamp(6)
  assinaturaStatus                   String                @default("trial")
  assinaturaExpiraEm                 DateTime?             @db.Timestamp(6)
  mercadoPagoAssinaturaId            String?
  responsavel                        String?
  assinaturaProximaCobrancaEm        DateTime?             @db.Timestamp(6)
  assinaturaRecorrenteAtiva          Boolean               @default(false)
  assinaturaUltimoLembreteWhatsappEm DateTime?             @db.Timestamp(6)
  modoPagamentoAssinatura            String                @default("manual")
  formaPagamentoAssinatura           String                @default("pix")
  bloqueadoPorInadimplencia          Boolean               @default(false)
  descontoMensal                     Decimal?              @db.Decimal(10, 2)
  observacoesInternas                String?
  statusFinanceiro                   String                @default("em_dia")
  ultimoPagamentoEm                  DateTime?             @db.Timestamp(6)
  valorMensalPersonalizado           Decimal?              @db.Decimal(10, 2)
  tipoCalculoComissao                String                @default("servico_executado")
  mercadoPagoAccessToken             String?
  mercadoPagoAtivo                   Boolean               @default(false)
  mercadoPagoAtualizadoEm            DateTime?             @db.Timestamp(6)
  mercadoPagoModo                    String                @default("sandbox")
  mercadoPagoPublicKey               String?
  mercadoPagoStatus                  String                @default("nao_configurado")
  solicitouIntegracaoMp              Boolean               @default(false)
  instagramUrl                       String?
  diasInadimplente                   Int                   @default(0)
  ultimoAvisoBloqueioEnviadoEm       DateTime?             @db.Timestamp(6)
  ultimoAvisoPagamentoAprovadoEm     DateTime?             @db.Timestamp(6)
  ultimoAvisoPagamentoRecusadoEm     DateTime?             @db.Timestamp(6)
  ultimoLembreteFinanceiroEnviadoEm  DateTime?             @db.Timestamp(6)
  agendamentos                       Agendamento[]
  clienteMovimentacoesFinanceiras     ClienteMovimentacaoFinanceira[]
  caixasDiarios                      CaixaDiario[]
  caixaMovimentacoes                 CaixaMovimentacao[]
  agendamentoServicos                AgendamentoServico[]
  clientes                           Cliente[]
  comissoes                          Comissao[]
  pagamentosComissao                 ComissaoPagamento[]
  disponibilidades                   Disponibilidade[]
  logs                               EmpresaLog[]
  pagamentosSaaS                     EmpresaPagamento[]
  pagamentos                         Pagamento[]
  pagamentosAssinatura               PagamentoAssinatura[]
  profissionais                      Profissional[]
  ProfissionalServico                ProfissionalServico[]
  promocoes                          Promocao[]
  promocoesUsos                      PromocaoUso[]
  servicos                           Servico[]
  usuarios                           UsuarioEmpresa[]
}

model Cliente {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId      String
  nome           String
  whatsapp       String
  cpf            String?
  dataNascimento DateTime?     @db.Timestamp(6)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  agendamentos   Agendamento[]
  movimentacoesFinanceiras ClienteMovimentacaoFinanceira[]
  empresa        Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Pagamento      Pagamento[]
  promocoesUsos  PromocaoUso[]

  @@unique([empresaId, cpf])
}

model Servico {
  id                       String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId                String
  nome                     String
  descricao                String?
  imagemUrl1 String?
  imagemUrl2 String?
  imagemUrl3 String?
  duracaoMin               Int                      @default(30)
  capacidadeSimultanea      Int                      @default(1)
  valor                    Decimal                  @default(0) @db.Decimal(10, 2)
  ativo                    Boolean                  @default(true)
  exigePagamento           Boolean                  @default(false)
  tipoPagamento            String?
  permiteAgendamentoOnline Boolean                  @default(true)
  ordem                    Int                      @default(0)
  createdAt                DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt                DateTime                 @default(now()) @updatedAt @db.Timestamp(6)
  exigePrePagamento        Boolean?                 @default(false)
  valorPrePagamento        Decimal?                 @db.Decimal
  tipoPrePagamento         String?
  tipoComissao             String?
  valorComissao            Decimal?                 @db.Decimal(10, 2)
  custo                    Decimal?                 @db.Decimal(10, 2)
  agendamentos             Agendamento[]
  agendamentoServicos      AgendamentoServico[]
  disponibilidades         DisponibilidadeServico[]
  profissionais            ProfissionalServico[]
  empresa                  Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ProfissionalToServico    ProfissionalToServico[]
  promocoes                       PromocaoServico[]
}

model Profissional {
  id                    String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId             String
  nome                  String
  fotoUrl               String?
  bio                   String?
  ativo                 Boolean                 @default(true)
  ordem                 Int                     @default(0)
  createdAt             DateTime                @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                @default(now()) @updatedAt @db.Timestamp(6)
  modoComissao  String @default("geral")
tipoComissao  String?
valorComissao Float?
  agendamentos          Agendamento[]
  agendamentoServicos   AgendamentoServico[]
  comissoes             Comissao[]
  pagamentosComissao    ComissaoPagamento[]
  disponibilidades      Disponibilidade[]
  empresa               Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  servicos              ProfissionalServico[]
  ProfissionalToServico ProfissionalToServico[]
}

model ProfissionalServico {
  id              String   @id @default(cuid())
  empresaId       String
  profissionalId  String
  servicoId       String

  tipoComissao    String?
  valorComissao   Float?

  createdAt       DateTime @default(now())
  updatedAt DateTime? @updatedAt

  empresa         Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  profissional    Profissional  @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  servico         Servico       @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, servicoId])
}

model Disponibilidade {
  id                      String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId               String
  profissionalId          String?
  diaSemana               Int
  horaInicio              String
  horaFim                 String
  intervaloMin            Int                      @default(30)
  ativo                   Boolean                  @default(true)
  tipo                    String                   @default("trabalho")
  updatedAt               DateTime                 @default(now()) @updatedAt @db.Timestamp(6)
  empresa                 Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profissional            Profissional?            @relation(fields: [profissionalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  disponibilidadeServicos DisponibilidadeServico[]
}

model DisponibilidadeServico {
  id                String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  disponibilidadeId String
  servicoId         String
  disponibilidade   Disponibilidade @relation(fields: [disponibilidadeId], references: [id], onDelete: Cascade)
  servico           Servico         @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([disponibilidadeId, servicoId])
  @@index([disponibilidadeId])
  @@index([servicoId])
}

model Agendamento {
  id                        String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId                 String
  servicoId                 String
  profissionalId            String?
  data                      String?
  horaInicio                String?
  duracaoMin                Int
  clienteNome               String?
  clienteCpf                String?
  clienteNascimento         String?
  clienteWhatsapp           String?
  status                    String               @default("pendente")
  createdAt                 DateTime             @default(now()) @db.Timestamp(6)
  nomeCliente               String?
  telefoneCliente           String?
  clienteId                 String?
  dataHoraInicio            DateTime?            @db.Timestamp(6)
  dataHoraFim               DateTime?            @db.Timestamp(6)
  valorTotal                Decimal              @default(0) @db.Decimal
  valorPrePago              Decimal?             @db.Decimal
  valorOriginalServico      Decimal?             @db.Decimal(10, 2)
  valorComDesconto          Decimal?             @db.Decimal(10, 2)
  valorEconomizado          Decimal?             @db.Decimal(10, 2)
  promocaoId                String?
  promocaoTitulo            String?
  promocaoDescricao         String?
  promocaoTipo              String?
  promocaoDesconto          Decimal?             @db.Decimal(10, 2)
  promocaoTipoDesconto      String?
  promocaoUsoUnicoCpf       Boolean              @default(false)
  statusPagamento           String               @default("pendente")
  origem                    String               @default("online")
  lembreteWhatsappEnviado   Boolean              @default(false)
  lembreteWhatsappEnviadoAt DateTime?            @db.Timestamp(6)
  updatedAt                 DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  comissaoGerada            Boolean              @default(false)
  canceladoEm               DateTime?            @db.Timestamp(6)
  motivoCancelamento        String?
  grupoAgendamentoId        String?
  cliente                   Cliente?             @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  empresa                   Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profissional              Profissional?        @relation(fields: [profissionalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servico                   Servico              @relation(fields: [servicoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicosAdicionais        AgendamentoServico[]
  comissoes                 Comissao[]
  pagamento                 Pagamento[]
  promocoesUsos             PromocaoUso[]
  clienteMovimentacoesFinanceiras ClienteMovimentacaoFinanceira[]

  @@index([grupoAgendamentoId])
}

model AgendamentoServico {
  id              String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId       String
  agendamentoId   String
  servicoId       String
  profissionalId  String?
  nomeServico     String
  valor           Decimal       @default(0) @db.Decimal(10, 2)
  statusPagamento String        @default("pendente")
  formaPagamento  String?
  observacao      String?
  origem          String        @default("painel")
  pagoEm          DateTime?     @db.Timestamp(6)
  createdAt       DateTime      @default(now()) @db.Timestamp(6)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  custo           Decimal?      @db.Decimal(10, 2)
  agendamento     Agendamento   @relation(fields: [agendamentoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  empresa         Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profissional    Profissional? @relation(fields: [profissionalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servico         Servico       @relation(fields: [servicoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comissoes       Comissao[]

  @@index([empresaId])
  @@index([agendamentoId])
  @@index([servicoId])
  @@index([profissionalId])
  @@index([statusPagamento])
  @@index([createdAt])
}

model Pagamento {
  id              String      @id(map: "pagamento_pkey") @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId       String
  agendamentoId   String
  clienteId       String?
  provedor        String      @default("mercadopago")
  externalId      String?
  preferenceId    String?
  valorTotal      Decimal     @default(0) @db.Decimal(10, 2)
  valorPago       Decimal     @default(0) @db.Decimal(10, 2)
  status          String      @default("pendente")
  metodoPagamento String?
  linkPagamento   String?
  qrCode          String?
  qrCodeBase64    String?
  paidAt          DateTime?   @db.Timestamp(6)
  createdAt       DateTime    @default(now()) @db.Timestamp(6)
  updatedAt       DateTime    @default(now()) @updatedAt @db.Timestamp(6)
  agendamento     Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pagamento_agendamentoid_fkey")
  Cliente         Cliente?    @relation(fields: [clienteId], references: [id], onUpdate: NoAction, map: "pagamento_clienteid_fkey")
  empresa         Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pagamento_empresaid_fkey")

  @@index([agendamentoId], map: "pagamento_agendamentoid_idx")
  @@index([externalId], map: "pagamento_externalid_idx")
}

model Comissao {
  id                   String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId            String
  agendamentoId        String
  profissionalId       String
  valorServico         Decimal             @default(0) @db.Decimal(10, 2)
  valorComissao        Decimal             @default(0) @db.Decimal(10, 2)
  tipoComissao         String?
  status               String              @default("pendente")
  dataPagamento        DateTime?           @db.Timestamp(6)
  observacao           String?
  createdAt            DateTime            @default(now()) @db.Timestamp(6)
  updatedAt            DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  agendamentoServicoId String?
  origemServico        String?             @default("principal")
  pagoEm               DateTime?           @db.Timestamp(6)
  percentualAplicado   Decimal?            @db.Decimal(10, 2)
  repasseObservacao    String?
  valorBaseRecebido    Decimal?            @db.Decimal(10, 2)
  pagamentoId          String?
  agendamento          Agendamento         @relation(fields: [agendamentoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agendamentoServico   AgendamentoServico? @relation(fields: [agendamentoServicoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pagamentoComissao    ComissaoPagamento?  @relation(fields: [pagamentoId], references: [id])
  profissional         Profissional        @relation(fields: [profissionalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresaId])
  @@index([agendamentoId])
  @@index([profissionalId])
  @@index([agendamentoServicoId])
  @@index([status])
  @@index([createdAt])
}

model Promocao {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId             String
  servicoId             String?
  tipo                  String    @default("geral")
  titulo                String
  descricao             String?
  mensagemWhatsapp      String?
  dataInicio            DateTime? @db.Timestamp(6)
  dataFim               DateTime? @db.Timestamp(6)
  tipoDesconto          String?
  desconto              Decimal?  @db.Decimal(10, 2)
  status                String    @default("ativa")
  createdAt             DateTime  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  whatsappEnviadoAt     DateTime? @db.Timestamp(6)
  whatsappTotalEnviados Int       @default(0)
  whatsappTotalErros    Int       @default(0)
  usoUnicoCpf           Boolean   @default(false)
  servicos              PromocaoServico[]
  usos                  PromocaoUso[]
  empresa               Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PromocaoUso {
  id            String      @id @default(cuid())
  empresaId     String
  promocaoId    String
  clienteId     String?
  agendamentoId String?
  cpf           String
  usedAt        DateTime    @default(now()) @db.Timestamp(6)
  createdAt     DateTime    @default(now()) @db.Timestamp(6)

  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  promocao      Promocao    @relation(fields: [promocaoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cliente       Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([promocaoId, cpf])
  @@index([empresaId])
  @@index([cpf])
  @@index([clienteId])
  @@index([agendamentoId])
}

model UsuarioEmpresa {
  id                         String    @id @default(uuid())
  empresaId                  String
  nome                       String
  email                      String    @unique
  whatsapp                   String?
  senhaHash                  String
  perfil                     String?   @default("admin")
  ativo                      Boolean?  @default(true)
  codigoRecuperacao          String?
  codigoRecuperacaoExpiraEm  DateTime? @db.Timestamp(6)
  createdAt                  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt                  DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  permissoes                 Json?
  empresa                    Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_empresa")
}

model PagamentoAssinatura {
  id                           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId                    String
  valor                        Decimal   @default(0) @db.Decimal(10, 2)
  status                       String    @default("pendente")
  preferenceId                 String?
  paymentId                    String?
  linkPagamento                String?
  vencimento                   DateTime? @db.Timestamp(6)
  dataPagamento                DateTime? @db.Timestamp(6)
  createdAt                    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt                    DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  mercadoPagoAssinaturaId      String?
  tipo                         String    @default("manual")
  whatsappConfirmacaoEnviadoAt DateTime? @db.Timestamp(6)
  whatsappLembreteEnviadoAt    DateTime? @db.Timestamp(6)
  empresa                      Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresaId])
  @@index([mercadoPagoAssinaturaId])
  @@index([paymentId])
  @@index([preferenceId])
}

model ProfissionalToServico {
  A            String
  B            String
  Profissional Profissional @relation(fields: [A], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Servico      Servico      @relation(fields: [B], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([A, B])
  @@map("_ProfissionalToServico")
}

model EmpresaLog {
  id        String   @id @default(uuid())
  empresaId String
  tipo      String
  motivo    String
  criadoEm  DateTime @default(now())
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model EmpresaPagamento {
  id        String   @id @default(uuid())
  empresaId String
  valor     Decimal  @db.Decimal(10, 2)
  status    String
  descricao String?
  criadoEm  DateTime @default(now())
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model ComissaoPagamento {
  id             String       @id @default(cuid())
  empresaId      String
  profissionalId String
  valorPago      Decimal      @db.Decimal(10, 2)
  dataInicio     DateTime?
  dataFim        DateTime?
  observacao     String?
  createdAt      DateTime     @default(now())
  comissoes      Comissao[]
  empresa        Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([profissionalId])
  @@index([createdAt])
}

model ClienteMovimentacaoFinanceira {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId     String
  clienteId     String
  agendamentoId String?
  tipo          String
  valor         Decimal      @default(0) @db.Decimal(10, 2)
  origem        String       @default("ajuste_manual")
  status        String       @default("ativo")
  observacao    String?
  usadoEmAgendamentoId String?
  createdAt     DateTime     @default(now()) @db.Timestamp(6)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamp(6)

  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([empresaId])
  @@index([clienteId])
  @@index([agendamentoId])
  @@index([tipo])
  @@index([status])
  @@index([createdAt])
}

model ConfiguracaoSaas {
  id                String   @id @default(cuid())
  valorPlanoBasico  Decimal  @default(49.90) @db.Decimal(10, 2)
  valorPlanoPlus    Decimal  @default(99.90) @db.Decimal(10, 2)
  valorPlanoPremium Decimal  @default(149.90) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

}

model PromocaoServico {
  id          String    @id @default(cuid())
  promocaoId  String
  servicoId   String

  promocao    Promocao  @relation(fields: [promocaoId], references: [id], onDelete: Cascade)
  servico     Servico   @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@unique([promocaoId, servicoId])
}


model CaixaDiario {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId          String
  data               DateTime            @db.Date
  status             String              @default("aberto")
  saldoInicial       Decimal             @default(0) @db.Decimal(10, 2)
  saldoSistema       Decimal             @default(0) @db.Decimal(10, 2)
  saldoDinheiroSistema Decimal           @default(0) @db.Decimal(10, 2)
  saldoPixSistema      Decimal           @default(0) @db.Decimal(10, 2)
  saldoDebitoSistema   Decimal           @default(0) @db.Decimal(10, 2)
  saldoCreditoSistema  Decimal           @default(0) @db.Decimal(10, 2)
  saldoOutroSistema    Decimal           @default(0) @db.Decimal(10, 2)
  saldoInformado     Decimal?            @db.Decimal(10, 2)
  saldoDinheiroInformado Decimal?        @db.Decimal(10, 2)
  saldoPixInformado      Decimal?        @db.Decimal(10, 2)
  saldoDebitoInformado   Decimal?        @db.Decimal(10, 2)
  saldoCreditoInformado  Decimal?        @db.Decimal(10, 2)
  saldoOutroInformado    Decimal?        @db.Decimal(10, 2)
  diferenca          Decimal?            @db.Decimal(10, 2)
  diferencaDinheiro  Decimal?            @db.Decimal(10, 2)
  diferencaPix       Decimal?            @db.Decimal(10, 2)
  diferencaDebito    Decimal?            @db.Decimal(10, 2)
  diferencaCredito   Decimal?            @db.Decimal(10, 2)
  diferencaOutro     Decimal?            @db.Decimal(10, 2)
  abertoEm           DateTime            @default(now()) @db.Timestamp(6)
  fechadoEm          DateTime?           @db.Timestamp(6)
  abertoPorUsuarioId String?
  abertoPorNome      String?
  fechadoPorUsuarioId String?
  fechadoPorNome     String?
  observacaoAbertura String?
  observacaoFechamento String?
conferenciaStatus String   @default("pendente")
conferidoEm DateTime?      @db.Timestamp(6)
conferidoPorUsuarioId String?
conferidoPorNome String?
observacaoConferencia String?
  createdAt          DateTime            @default(now()) @db.Timestamp(6)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamp(6)

  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movimentacoes      CaixaMovimentacao[]

  @@index([empresaId, data])
  @@index([empresaId])
  @@index([data])
  @@index([status])
}

model CaixaMovimentacao {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresaId     String
  caixaId       String?
  tipo          String
  categoria     String      @default("operacional")
  formaPagamento String?
  valor         Decimal      @default(0) @db.Decimal(10, 2)
  descricao     String
  origem        String      @default("manual")
  referenciaId  String?
  usuarioId     String?
  usuarioNome   String?
  createdAt     DateTime    @default(now()) @db.Timestamp(6)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamp(6)

  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  caixa         CaixaDiario? @relation(fields: [caixaId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([empresaId])
  @@index([caixaId])
  @@index([tipo])
  @@index([categoria])
  @@index([createdAt])
}
